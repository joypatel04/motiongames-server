# Server
PORT=3000
WS_PORT=3001
NODE_ENV=development

# Hardware
DRIVER_MODE=mock
# TILE_DRIVER overrides DRIVER_MODE when set: mock | moka | moka-serial
# TILE_DRIVER=mock
TILE_ROWS=16
TILE_COLS=12

# MOKA TCP (via USR-N540)
MOKA_HOST=192.168.1.100
MOKA_PORT=8234

# MOKA Serial (direct USB)
MOKA_SERIAL_PORT=/dev/ttyUSB0
MOKA_BAUD_RATE=115200

# Database
SQLITE_PATH=./data/arena.db

# Supabase sync
# Only set these in production / on the actual arena hardware. Leave blank
# in dev so the server runs offline against seeded local SQLite games.
SUPABASE_URL=https://agqnqwispnaytefftgpe.supabase.co
SUPABASE_ANON_KEY=
# Service-role key used by CatalogSync to read non-public games. Optional.
SUPABASE_SERVICE_KEY=
SHOP_ID=
SCORE_SYNC_INTERVAL_MS=10000
CATALOG_SYNC_INTERVAL_MS=60000

# Partner profile (branding shown by the launcher / simulator)
# When unset or Supabase is offline, the server falls back to a default
# 'Strikee Arena' profile.
PARTNER_SLUG=

# Logging
LOG_LEVEL=info
